{
  "name": "EmailLog",
  "type": "object",
  "properties": {
    "to_email": {
      "type": "string",
      "description": "Recipient address"
    },
    "from_email": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "body": {
      "type": "string",
      "description": "Message that was sent"
    },
    "kind": {
      "type": "string",
      "enum": [
        "photo",
        "code",
        "custom"
      ],
      "default": "custom"
    },
    "content_title": {
      "type": "string"
    },
    "content_url": {
      "type": "string"
    },
    "template_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "failed"
      ],
      "default": "sent"
    },
    "error": {
      "type": "string"
    }
  },
  "required": [
    "to_email",
    "subject"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
