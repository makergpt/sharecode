{
  "name": "SharedFile",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "5-character share code"
    },
    "file_url": {
      "type": "string",
      "description": "Uploaded file URL"
    },
    "file_name": {
      "type": "string"
    },
    "file_size": {
      "type": "number"
    },
    "file_type": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "direct",
        "gdrive",
        "onedrive",
        "dropbox"
      ],
      "default": "direct"
    },
    "external_url": {
      "type": "string",
      "description": "External cloud link"
    },
    "uses_type": {
      "type": "string",
      "enum": [
        "single",
        "multi",
        "unlimited"
      ],
      "default": "single"
    },
    "uses_remaining": {
      "type": "number",
      "default": 1
    },
    "total_downloads": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "virus_check_status": {
      "type": "string",
      "enum": [
        "pending",
        "clean",
        "suspicious",
        "unknown"
      ],
      "default": "pending"
    },
    "integrity_status": {
      "type": "string",
      "enum": [
        "ok",
        "broken",
        "unknown"
      ],
      "default": "unknown"
    },
    "check_notes": {
      "type": "string",
      "rls": {
        "read": {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "uploader_id": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "file_name",
    "uses_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": null,
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
