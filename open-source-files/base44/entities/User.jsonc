{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "display_name": {
      "type": "string",
      "description": "Name the user wants to be shown as"
    },
    "avatar_uri": {
      "type": "string",
      "description": "Private file uri of the user's profile picture"
    },
    "accent_color": {
      "type": "string",
      "description": "Accent colour hex used across the app"
    },
    "whatsapp_number": {
      "type": "string",
      "description": "WhatsApp number share codes are sent to"
    },
    "telegram_handle": {
      "type": "string",
      "description": "Telegram username share codes are sent to"
    }
  },
  "required": [
    "role"
  ]
}
